{
  "name": "mac-pdf-editor",
  "version": "1.6.0-beta.2",
  "description": "Tomorrow Now PDF Editor: editor PDF locale per macOS e Windows",
  "author": "Tomorrow Now",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/Trader855/PDF#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Trader855/PDF.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "backend": "node scripts/run_venv_python.cjs backend/main.py",
    "test": "pnpm run test:backend && pnpm run test:js",
    "test:backend": "node scripts/run_venv_python.cjs -m unittest discover -s tests -v",
    "test:js": "node --check main.js && node --check desktop-security.js && node --check platform-runtime.js && node --check preload.js && node --check renderer.js && node --check path-utils.mjs && node --test tests/security.test.cjs tests/platform-runtime.test.cjs tests/path-utils.test.mjs",
    "test:real-pdf": "node scripts/run_venv_python.cjs -m unittest discover -s tests -v",
    "test:packaged": "node scripts/run_venv_python.cjs scripts/qa_packaged_backend.py",
    "test:ocr:windows": "node scripts/run_venv_python.cjs scripts/qa_windows_ocr.py",
    "test:ui": "node scripts/qa_desktop_ui.cjs",
    "qa:release": "pnpm run test && pnpm run build:all && pnpm run dist:mac && pnpm run finalize:dmg && pnpm run test:packaged",
    "build:ocr": "CLANG_MODULE_CACHE_PATH=/tmp/mac-pdf-editor-clang-cache xcrun clang -fobjc-arc -framework Foundation -framework AppKit -framework Vision scripts/mac_pdf_ocr.m -O2 -o dist/mac-pdf-ocr",
    "build:backend": "node scripts/run_venv_python.cjs -m PyInstaller --noconfirm --clean --onefile --name mac-pdf-backend backend/main.py",
    "build:backend:win": "node scripts/run_venv_python.cjs -m PyInstaller --noconfirm --clean --onefile --name windows-pdf-backend backend/main.py",
    "build:all": "pnpm run build:ocr && pnpm run build:backend",
    "build:win": "pnpm run build:backend:win",
    "dist:mac": "electron-builder --mac dmg zip --arm64",
    "dist:win": "electron-builder --config electron-builder.windows.cjs --win nsis zip --x64 --publish never",
    "qa:windows": "pnpm run test && pnpm run test:ocr:windows && pnpm run test:ui && pnpm run build:win && pnpm run dist:win && pnpm run test:packaged",
    "finalize:dmg": "node scripts/finalize_dmg.js"
  },
  "devDependencies": {
    "@electron/notarize": "2.5.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "playwright-core": "1.63.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "pdfjs-dist": "^6.3.289"
  },
  "build": {
    "appId": "it.lettera.macpdfeditor",
    "productName": "Mac PDF Editor",
    "asar": true,
    "npmRebuild": false,
    "afterSign": "scripts/notarize.js",
    "artifactName": "Mac-PDF-Editor-${version}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "Trader855",
        "repo": "PDF",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "desktop-security.js",
      "platform-runtime.js",
      "path-utils.mjs",
      "preload.js",
      "renderer.js",
      "index.html",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "node_modules/pdfjs-dist/build/*.mjs",
      "node_modules/pdfjs-dist/cmaps/**/*",
      "node_modules/pdfjs-dist/standard_fonts/**/*",
      "node_modules/pdfjs-dist/wasm/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/mac-pdf-backend",
        "to": "backend/mac-pdf-backend"
      },
      {
        "from": "dist/mac-pdf-ocr",
        "to": "backend/mac-pdf-ocr"
      },
      {
        "from": "assets/fonts",
        "to": "fonts"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon_1024.png",
      "identity": "Gabriele Lettera (58WG2698V4)",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Mac PDF Editor ${version}",
      "iconSize": 112,
      "window": {
        "width": 560,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
